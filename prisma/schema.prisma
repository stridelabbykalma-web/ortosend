// ============================================================
// ORTOSEND — Modelo de datos completo (PostgreSQL + Prisma)
// Refleja todo el diseño funcional acordado. RGPD: datos de
// salud, retención 5 años, registro de accesos (AuditLog).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Usuarios y roles ----------
enum Role {
  ADMIN            // Administración Ortosend
  ADMIN_CLINICA
  PROFESIONAL      // de clínica (prescriptor o técnico según profile.canPrescribe)
  RECETADOR        // prescriptor central de Ortosend
  TALLER
  CLIENTE
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?              // null hasta activar cuenta (invitación Flujo B)
  role         Role
  name         String
  active       Boolean  @default(true)
  invitedAt    DateTime?            // invitación enviada (Flujo B)
  activatedAt  DateTime?
  clinicId     String?
  clinic       Clinic?  @relation(fields: [clinicId], references: [id])
  professional ProfessionalProfile?
  patients     Patient[]            // un titular puede gestionar varios pacientes (hijos)
  createdAt    DateTime @default(now())
  auditLogs    AuditLog[]
  // Agenda (profesional de clínica): horario semanal, excepciones y citas asignadas
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  appointments           Appointment[]
  calendarToken String?  @unique     // suscripción iCal privada (/api/ical/<token>)
}

// Ficha obligatoria del profesional (las cuentas las crea Ortosend)
model ProfessionalProfile {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id])
  dni           String
  degree        String            // titulación
  canPrescribe  Boolean @default(false) // solo podólogos y médicos, verificados
  collegiateNum String?           // nº colegiado (obligatorio si canPrescribe)
  college       String?           // colegio profesional y provincia
  docsUrl       String?           // título / certificado colegiación
  verifiedAt    DateTime?         // verificación de colegiación por Ortosend
  training      TrainingRecord[]
}

// Formación obligatoria: sin 5/5 no hay acceso al panel
model TrainingRecord {
  id             String   @id @default(cuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])
  module         String   // M1 sistema, M2 escáner, M3 Podisense, M4 vídeos, M5 reciclaje anual
  completedAt    DateTime
  expiresAt      DateTime?  // reciclaje anual
}

// ---------- Clínicas ----------
enum ClinicStatus {
  SOLICITUD
  REVISION
  APROBADA
  FORMACION
  ACTIVA
  SUSPENDIDA
  BAJA
}

model Clinic {
  id           String       @id @default(cuid())
  name         String
  cif          String?
  address      String
  town         String
  postalCode   String
  lat          Float?       // posición en el mapa
  lng          Float?
  status       ClinicStatus @default(SOLICITUD)
  hasPrescriber Boolean     @default(false) // si no: casos → cola central
  contractUrl  String?
  // Ajustes de la agenda y de la reserva online
  timezone         String  @default("Europe/Madrid")
  slotMinutes      Int     @default(45)   // duración de la cita de estudio
  minNoticeHours   Int     @default(24)   // antelación mínima para reservar online
  bookingHorizonDays Int   @default(45)   // hasta cuántos días vista se puede reservar
  onlineBooking    Boolean @default(true) // publica su agenda en la web
  patientPicksPro  Boolean @default(false) // el paciente puede elegir profesional
  calendarToken    String? @unique        // suscripción iCal de toda la clínica
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  appointments           Appointment[]
  users        User[]
  cases        Case[]
  equipment    Equipment[]
  settlements  Settlement[]
  professionalApplications ProfessionalApplication[]
  createdAt    DateTime     @default(now())
}

// ---------- Agenda y citas ----------
// Cada clínica tiene una agenda propia (sala/equipo, con capacidad) y cada
// profesional la suya. La disponibilidad online es la unión de todas las que
// tengan `online = true`, recortada por las excepciones y las citas ya dadas.
// Los minutos son de reloj local de la clínica (timezone); 540 = 09:00.

// Horario semanal recurrente. professionalId null = agenda de la clínica.
model AvailabilityRule {
  id             String   @id @default(cuid())
  clinicId       String
  clinic         Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  professionalId String?
  professional   User?    @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  weekday        Int      // ISO: 1 lunes … 7 domingo
  startMin       Int
  endMin         Int
  capacity       Int      @default(1) // citas simultáneas (agenda de clínica: nº de salas)
  online         Boolean  @default(true) // reservable desde la web; si no, solo la da la clínica
  createdAt      DateTime @default(now())

  @@index([clinicId, weekday])
}

enum ExceptionKind {
  CIERRE    // festivo, vacaciones, baja: no se dan citas
  APERTURA  // franja extra fuera del horario semanal
}

// Excepción por fechas (rango inclusivo). Sin horas = el día entero.
model AvailabilityException {
  id             String        @id @default(cuid())
  clinicId       String
  clinic         Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  professionalId String?       // null = afecta a toda la clínica (todas las agendas)
  professional   User?         @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  kind           ExceptionKind
  startsOn       DateTime      @db.Date
  endsOn         DateTime      @db.Date
  startMin       Int?
  endMin         Int?
  capacity       Int           @default(1)
  online         Boolean       @default(true)
  note           String?
  createdAt      DateTime      @default(now())

  @@index([clinicId, startsOn, endsOn])
}

enum AppointmentStatus {
  RESERVADA
  CONFIRMADA     // el paciente confirmó desde el recordatorio
  COMPLETADA     // el paciente vino (el estudio arrancó)
  CANCELADA
  NO_PRESENTADO
}

enum AppointmentKind {
  ESTUDIO      // primera visita: estudio completo
  REPETICION   // repetir una prueba (caso devuelto a clínica), sin coste
  REVISION     // revisión anual / seguimiento
  AJUSTE       // ajuste post-entrega
}

// Cita concreta. Un caso puede tener varias a lo largo de su vida (estudio,
// repetición, revisión…); la vigente se refleja en Case.appointmentAt.
model Appointment {
  id             String            @id @default(cuid())
  clinicId       String
  clinic         Clinic            @relation(fields: [clinicId], references: [id])
  professionalId String?           // null = agenda de la clínica
  professional   User?             @relation(fields: [professionalId], references: [id])
  caseId         String
  case           Case              @relation(fields: [caseId], references: [id])
  kind           AppointmentKind   @default(ESTUDIO)
  status         AppointmentStatus @default(RESERVADA)
  startsAt       DateTime
  endsAt         DateTime
  source         String            // web | clinica | cliente (reprogramada desde el panel)
  bookedBy       String?           // userId de quien la dio (null = visitante web)
  notes          String?
  cancelledAt    DateTime?
  cancelledBy    String?
  cancelReason   String?
  reminderSentAt DateTime?         // recordatorio 24 h encolado
  createdAt      DateTime          @default(now())

  @@index([clinicId, startsAt])
  @@index([professionalId, startsAt])
  @@index([caseId])
}

// Equipamiento en cesión (inventario Ortosend)
model Equipment {
  id        String   @id @default(cuid())
  clinicId  String?
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
  type      String   // "Revopoint Inspire 2" | "Podisense GO" | "Tablet" | "Trípode"
  serial    String   @unique
  deliveredAt DateTime?
  returnedAt  DateTime?
}

// ---------- Pacientes y casos ----------
model Patient {
  id        String  @id @default(cuid())
  ownerId   String            // titular (User CLIENTE); menores: titular = adulto
  owner     User    @relation(fields: [ownerId], references: [id])
  name      String
  birthDate DateTime?
  dni       String?
  isMinor   Boolean @default(false)
  consents  Json               // RGPD: salud, WhatsApp — con fecha y versión de texto
  cases     Case[]
}

// Los 11 estados + excepciones. La numeración acordada:
// 1 Cita reservada · 2 Estudio en curso · 3 Estudio completo/enviado ·
// 4 En prescripción · 5 Prescrito, pendiente de pago · 6 Pagado/entrada taller ·
// 7 Diseño · 8 Fabricación (mecanizado CNC → confección a mano) ·
// 9 Control de calidad · 10 Enviado · 11 Entregado/cerrado (seguimiento + revisión anual)
enum CaseState {
  CITA_RESERVADA
  ESTUDIO_EN_CURSO
  ESTUDIO_COMPLETO
  EN_PRESCRIPCION
  EN_CONTACTO          // prescriptor quiere hablar con el paciente
  PENDIENTE_PAGO       // enlace válido 30 días; caducidad blanda reactivable hasta 6 meses
  ENTRADA_TALLER
  DISENO
  FABRICACION
  CALIDAD
  ENVIADO
  ENTREGADO
  CERRADO
  DEVUELTO_CLINICA     // repetir prueba (sin coste para el cliente)
  NO_PRESCRITO         // cliente no paga, clínica no cobra
  NO_CONVERTIDO        // enlace de pago caducado
}

enum FabPhase {
  MECANIZADO
  CONFECCION
}
enum Delivery {
  DOMICILIO
  CLINICA
}

model Case {
  id           String    @id @default(cuid())
  number       Int       @unique @default(autoincrement())
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id])
  clinicId     String
  clinic       Clinic    @relation(fields: [clinicId], references: [id])
  state        CaseState @default(CITA_RESERVADA)
  flow         String    // "A" (web) | "B" (clínica)
  appointmentAt DateTime?  // próxima cita vigente (desnormalizado de Appointment)
  appointments Appointment[]
  // Reparto automático: al abrir, queda asociado; se libera al terminar,
  // cerrar sesión o por inactividad (45 min)
  openBy       String?
  openAt       DateTime?
  assignedTo   String?   // asignación pegajosa tras contacto con el paciente
  capture      Capture?
  prescription Prescription?
  payment      Payment?
  shipment     Shipment?
  delivery     Delivery?
  fabPhase     FabPhase?
  lot          String?   // lote de mecanizado CNC
  material     String?   // trazabilidad: lote de material en confección
  designFileUrl String?  // CAD archivado (reposiciones / revisión anual)
  rxDraft      String?   // borrador de valoración guardado al soltar el caso
  // Quién receta, elegido al enviar: CLINICA (lo firma quien envió) |
  // ORTOSEND (cola central) | REVISION (Ortosend revisa y devuelve; firma la clínica)
  rxRoute      String?
  rxRequestedBy String?  // User de la clínica que envió el estudio
  qcPhotoUrl   String?   // foto obligatoria del par en calidad
  payLinkExpiresAt DateTime? // 30 días; recordatorios días 0/3/7/15
  incidents    Incident[]
  events       CaseEvent[]
  annualReviewAt DateTime? // revisión anual programada al cerrar
  createdAt    DateTime  @default(now())
}

// Captura del estudio (asistente multi-dispositivo, guardado continuo)
model Capture {
  id        String  @id @default(cuid())
  caseId    String  @unique
  case      Case    @relation(fields: [caseId], references: [id])
  questionnaire Json?   // cuestionario clínico (paso 2 del protocolo)
  physicalExam  Json?   // exploración + núcleo de 5 tests y complementarios por rama
  media     MediaAsset[]
  baroFileUrl String?   // informe del dashboard Podisense (vía 2; vía 1 = API Fresco)
  completedAt DateTime? // checklist superada → envío
}

// Capturas de la cámara de la app: 4 vídeos de marcha descalzo (lateral dcha.,
// lateral izq., posterior y anterior) + 2 fotos de los pies de cerca
// (desde atrás y desde delante). El escaneo de espumas y la baropodometría se
// marcan como hechos porque los produce su propia plataforma.
model MediaAsset {
  id        String  @id @default(cuid())
  captureId String
  capture   Capture @relation(fields: [captureId], references: [id])
  kind      String  // video_post_descalzo | video_ant_descalzo | foto_posterior | foto_anterior | baro_est | baro_din_multi | scan_espumas
  url       String
  sizeBytes Int?
  meta      Json?     // métricas del estudio de captura: duración, s con encuadre válido (MediaPipe), mime…
  confirmedAt DateTime? // check verde SOLO cuando el servidor confirma
  blob      MediaBlob?
}

// Contenido binario de la captura (prototipo: en Postgres; producción: R2/S3 por fragmentos).
// Tabla separada para no arrastrar los bytes en las lecturas normales del caso.
model MediaBlob {
  id      String     @id @default(cuid())
  mediaId String     @unique
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mime    String
  bytes   Bytes
}

// Documento clínico firmado — sin prescripción no se fabrica
model Prescription {
  id           String   @id @default(cuid())
  caseId       String   @unique
  case         Case     @relation(fields: [caseId], references: [id])
  prescriberId String              // User con canPrescribe verificado
  prescriberName String
  collegiateNum String
  assessment   String              // valoración clínica
  diagnosis    String
  fabricationOrder String          // pauta de fabricación (→ hoja de trabajo)
  usageGuidelines  String          // pauta de uso para el paciente
  contactNotes String?             // notas de llamadas al paciente
  pdfUrl       String?             // PDF firmado, inmutable, retención 5 años
  signedAt     DateTime @default(now())
}

// Pago siempre vía Ortosend (Stripe: tarjeta/Bizum). Sin pago no se fabrica.
model Payment {
  id        String   @id @default(cuid())
  caseId    String   @unique
  case      Case     @relation(fields: [caseId], references: [id])
  amountCents Int    @default(19999)
  provider  String   @default("stripe")
  providerId String?           // payment_intent
  method    String?            // card | bizum
  paidAt    DateTime?
  invoiceUrl String?
}

model Shipment {
  id        String   @id @default(cuid())
  caseId    String   @unique
  case      Case     @relation(fields: [caseId], references: [id])
  carrier   String?
  tracking  String?
  toClinic  Boolean  @default(false) // recogida en clínica
  shippedAt DateTime?
  deliveredAt DateTime?
}

enum IncidentType {
  CAPTURA_INVALIDA
  REHACER_DEFECTO
  AJUSTE_POST_ENTREGA
  GARANTIA
}

model Incident {
  id       String @id @default(cuid())
  caseId   String
  case     Case   @relation(fields: [caseId], references: [id])
  type     IncidentType
  reason   String
  resolution String?
  openedBy String
  closedAt DateTime?
  createdAt DateTime @default(now())
}

// Historial completo del caso (quién, qué, cuándo)
model CaseEvent {
  id      String   @id @default(cuid())
  caseId  String
  case    Case     @relation(fields: [caseId], references: [id])
  text    String
  actor   String
  at      DateTime @default(now())
}

// ---------- Captación y operaciones ----------
model ClinicApplication {
  id        String   @id @default(cuid())
  name      String
  town      String
  contact   String
  hasPrescriber Boolean
  notes     String?
  status    String   @default("recibida") // recibida | revision | aprobada | rechazada
  createdAt DateTime @default(now())
}

model WaitlistEntry {   // zonas sin cobertura — dónde captar la próxima clínica
  id      String   @id @default(cuid())
  zone    String
  contact String
  createdAt DateTime @default(now())
}

// Liquidación mensual a clínicas contra factura (importes pendientes de definir)
model Settlement {
  id        String  @id @default(cuid())
  clinicId  String
  clinic    Clinic  @relation(fields: [clinicId], references: [id])
  period    String  // "2026-08"
  amountCents Int?
  invoiceUrl String?
  paidAt    DateTime?
}

// Cola de mensajes WhatsApp (canal principal) — solo avisos + enlace,
// NUNCA contenido clínico. Email como respaldo.
model Notification {
  id       String   @id @default(cuid())
  toPhone  String
  template String   // cita_confirmada | recordatorio_24h | estudio_completo | rx_lista_pago |
                    // pago_d3 | pago_d7 | pago_d15 | enviado | entregado | adaptacion_d20 | revision_anual …
  payload  Json
  sentAt   DateTime?
  createdAt DateTime @default(now())
}

// Registro de accesos a datos de salud (obligación RGPD)
model AuditLog {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id])
  action  String   // p.ej. "case.view", "prescription.download"
  target  String
  at      DateTime @default(now())
}

// Solicitud de alta de profesional presentada por el admin de una clínica.
// Ortosend valida la ficha (y la colegiación si prescribe) y crea la cuenta.
model ProfessionalApplication {
  id            String   @id @default(cuid())
  clinicId      String
  clinic        Clinic   @relation(fields: [clinicId], references: [id])
  requestedBy   String              // userId del admin de clínica solicitante
  fullName      String
  dni           String
  email         String
  phone         String
  degree        String              // titulación
  canPrescribe  Boolean  @default(false)
  collegiateNum String?             // obligatorio si canPrescribe
  college       String?             // colegio profesional y provincia
  notes         String?
  status        String   @default("recibida") // recibida | aprobada | rechazada
  resolutionNote String?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
}
