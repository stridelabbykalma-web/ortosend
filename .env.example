# Base de datos (Neon en producción)
DATABASE_URL=postgresql://usuario:clave@localhost:5432/ortosend
# Firma de sesiones y pimienta de los códigos de acceso
AUTH_SECRET=cambia-esto-por-un-texto-largo-aleatorio

# Email (opcional; sin ellos los emails quedan encolados en el panel de admin)
RESEND_API_KEY=
EMAIL_FROM=

# Cron diario (/api/cron)
CRON_SECRET=

# ManyChat — alta de pacientes por WhatsApp (ver docs/ALTA-WHATSAPP.md).
# Sin MANYCHAT_API_KEY los envíos se simulan y quedan en el panel de admin.
MANYCHAT_API_KEY=
MANYCHAT_WEBHOOK_SECRET=
MANYCHAT_FLOW_INVITACION=
MANYCHAT_FLOW_RECORDATORIO=
MANYCHAT_FLOW_ACCESO=
MANYCHAT_FLOW_CODIGO=
# Avisos del tratamiento: {"cita_confirmada":"content…","enviado":"content…", …} (ver docs §10)
MANYCHAT_FLOWS_AVISOS=

# Tests (npm test): Postgres donde crear esquemas temporales
TEST_DATABASE_URL=postgresql://usuario:clave@localhost:5432/ortosend_test
